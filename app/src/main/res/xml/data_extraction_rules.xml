<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) split of Auto Backup (§16): cloud-backup and device-to-device transfer
  are configured separately. Both carry the habit database; see backup_rules.xml for why the
  WAL sidecars are left out.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="habit.db" />
        <exclude domain="database" path="habit.db-wal" />
        <exclude domain="database" path="habit.db-shm" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="habit.db" />
        <exclude domain="database" path="habit.db-wal" />
        <exclude domain="database" path="habit.db-shm" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
